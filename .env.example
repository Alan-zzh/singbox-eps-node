# Singbox EPS Node 环境变量配置
# 复制此文件为 .env 并填写你的配置

# ============ 必填 ============
# 服务器公网IP（留空则自动检测）
SERVER_IP=
# Cloudflare域名（用于CDN和SSL证书）
CF_DOMAIN=

# ============ 协议密码（安装时自动生成，也可手动指定）============
# VLESS Reality UUID
VLESS_UUID=
# VLESS WS / HTTPUpgrade UUID
VLESS_WS_UUID=
# Trojan-WS密码
TROJAN_PASSWORD=
# Hysteria2密码
HYSTERIA2_PASSWORD=
# Reality私钥
REALITY_PRIVATE_KEY=
# Reality公钥
REALITY_PUBLIC_KEY=

# ============ 可选 ============
# Cloudflare API Token（用于申请15年SSL证书）
CF_API_TOKEN=
# 国家代码
COUNTRY_CODE=JP
# 订阅Token（留空则无需Token验证）
SUB_TOKEN=

# AI住宅IP SOCKS5（配置后AI网站流量自动走此代理）
# SOCKS5服务器地址
AI_SOCKS5_SERVER=
# SOCKS5端口
AI_SOCKS5_PORT=
# SOCKS5用户名
AI_SOCKS5_USER=
# SOCKS5密码
AI_SOCKS5_PASS=
# AI路由开关（on=开启，off=关闭，默认关闭）
AI_SOCKS5_ROUTING=off

# Telegram管理机器人
# Telegram Bot Token
TG_BOT_TOKEN=
# 管理员Chat ID
TG_ADMIN_CHAT_ID=
