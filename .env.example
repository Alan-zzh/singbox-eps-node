# Singbox EPS Node 环境变量配置
# 复制此文件为 .env 并填写你的配置

# ============ 部署模式（v4.15.0 新增，双模式支持）============
# cdn    = CDN混合模式（默认/推荐）：6节点（4直连+2WS-CDN），启动CDN监控，抗封锁能力强，需要CF域名
# direct = 纯直连模式：4节点（VLESS-Reality/VLESS-gRPC/Trojan-TCP/anyTLS），极简无CDN依赖，不启动singbox-cdn
# 向后兼容：未设置时，HK节点默认direct，其他节点默认cdn
DEPLOY_MODE=cdn

# ============ 必填 ============
# 服务器公网IP（留空则自动检测）
SERVER_IP=
# Cloudflare域名（CDN模式必填用于CDN和SSL证书；直连模式可选，无域名则使用自签名证书）
CF_DOMAIN=

# ============ 协议密码（安装时自动生成，也可手动指定）============
# VLESS Reality UUID
VLESS_UUID=
# VLESS WS UUID
VLESS_WS_UUID=
# Trojan-WS密码
TROJAN_PASSWORD=
# TUIC v5 UUID（v4.15.0 加回，ENABLE_TUIC=true 默认开启）
TUIC_UUID=
# TUIC v5密码（v4.15.0 加回，ENABLE_TUIC=true 默认开启）
TUIC_PASSWORD=
# TUIC v5开关（true=启用，false=禁用，v4.15.0 起默认 true，提供 UDP relay 支持）
ENABLE_TUIC=true
# anyTLS 协议密码（v4.14.0 新增，独立于 TROJAN_PASSWORD，安装时随机生成）
ANYTLS_PASSWORD=
# Reality私钥
REALITY_PRIVATE_KEY=
# Reality公钥
REALITY_PUBLIC_KEY=

# ============ 协议端口（v4.11.0 新增，直连协议使用随机端口避免被识别）============
# VLESS-gRPC端口（安装时随机生成10000-65535，也可手动指定）
VLESS_GRPC_PORT=
# Trojan-TCP端口（安装时随机生成10000-65535，也可手动指定）
TROJAN_TCP_PORT=
# TUIC v5端口（v4.15.0 加回，安装时随机生成，默认 50444）
TUIC_PORT=
# anyTLS 端口（v4.14.0 新增，固定 2096，CF CDN 支持端口之一）
ANYTLS_PORT=2096

# ============ 可选 ============
# Cloudflare API Token（用于申请15年SSL证书）
CF_API_TOKEN=
# 国家代码
COUNTRY_CODE=JP
# 订阅Token（留空则无需Token验证）
SUB_TOKEN=

# AI住宅IP SOCKS5（配置后AI网站流量自动走此代理）
# SOCKS5服务器地址
AI_SOCKS5_SERVER=
# SOCKS5端口
AI_SOCKS5_PORT=
# SOCKS5用户名
AI_SOCKS5_USER=
# SOCKS5密码
AI_SOCKS5_PASS=
# AI路由开关（on=开启，off=关闭，默认关闭）
AI_SOCKS5_ROUTING=off

# Telegram管理机器人
# Telegram Bot Token
TG_BOT_TOKEN=
# 管理员Chat ID
TG_ADMIN_CHAT_ID=

# ============ 健康监控与报警 ============
# SMTP服务器（如 smtp.qq.com, smtp.gmail.com）
MONITOR_SMTP_SERVER=
# SMTP端口（SSL一般为465）
MONITOR_SMTP_PORT=465
# 发件邮箱地址
MONITOR_SMTP_USER=
# 邮箱授权码/密码
MONITOR_SMTP_PASS=
# 报警收件邮箱
MONITOR_ALERT_EMAIL=
# 重启次数报警阈值（默认10次）
MONITOR_RESTART_THRESHOLD=10
# 监控检查间隔（秒，默认300=5分钟）
MONITOR_CHECK_INTERVAL=300

# ============ 用户DDNS锚点（v4.5 区域化CDN优选）============
# 用户DDNS域名（服务器通过此域名感知用户位置和网络状态）
USER_DDNS_DOMAIN=
# 用户预期运营商（电信/联通/移动，用于验证DDNS解析结果）
USER_EXPECTED_ISP=电信
# 用户网络探测间隔（秒，默认300=5分钟）
USER_PROBE_INTERVAL=300
# 延迟突增阈值（百分比，0.5=50%，超过则触发CDN刷新）
USER_LATENCY_SPIKE_THRESHOLD=0.5
# CDN模式（ip_optimized=优选IP / domain_optimized=优选域名 / domain_default=默认域名）
CDN_MODE=ip_optimized
# 优选域名列表（domain_optimized模式使用，逗号分隔）
CDN_OPTIMIZED_DOMAINS=icook.hk,icook.tw,cf.090227.xyz,time.is,www.visa.cn,mfa.gov.ua,bestcf.030101.xyz,saas.sin.fan
# 旧配置（已废弃，兼容映射：true→ip_optimized, false→domain_default）
#CDN_PREFER_IP_OVER_DOMAIN=false

# ============ 三网优选API（v4.9 自动根据用户运营商匹配）============
# 以下API由系统自动调用，无需手动配置
# cf.090227.xyz/ct → 电信专属优选IP
# cf.090227.xyz/cu → 联通专属优选IP
# cf.090227.xyz/cmcc → 移动专属优选IP
# 系统通过DDNS域名识别用户运营商，自动匹配对应API

# ============ 爱快路由器（v4.10.6 用户路径测速辅助）============
# 爱快路由器管理地址（内网IP，VPS不可直连，仅记录备用）
IKUAI_IP=
# 爱快路由器管理员用户名
IKUAI_USER=
# 爱快路由器管理员密码
IKUAI_PASS=

# ============ Cloudflare WARP 原生解锁（v4.13 本地零成本解锁AI/流媒体）============
# 解锁开关（on=开启，off=关闭，默认关闭）
# 开启后：OpenAI/ChatGPT/Gemini/Claude/TikTok/Netflix 自动走WARP
# X/Twitter/Google/YouTube/其他网站保持服务器直连
# 运行 scripts/warp_unlock.sh 一键自动配置，无需手动填写以下参数
WARP_UNLOCK=off
# WARP WireGuard私钥（脚本自动生成）
WARP_PRIVATE_KEY=
# WARP节点公钥（固定值）
WARP_PEER_PUBLIC_KEY=bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo=
# WARP节点地址
WARP_PEER_ENDPOINT=162.159.193.10:2408
# 客户端IPv4地址（脚本自动生成）
WARP_CLIENT_IPV4=
# 客户端IPv6地址（脚本自动生成）
WARP_CLIENT_IPV6=
# WARP reserved字段（逗号分隔三个数字，脚本自动生成）
WARP_RESERVED=
